{
  "mappings": [
    {
      "name": "EXP-01 escenario B: 800ms de latencia (85% del trafico)",
      "priority": 2,
      "request": { "method": "GET", "urlPathPattern": "/perfil.*" },
      "response": {
        "status": 200,
        "jsonBody": { "score": 720, "fuente": "open-finance" },
        "fixedDelayMilliseconds": 800
      }
    },
    {
      "name": "EXP-01 escenario B: 15% de errores",
      "priority": 1,
      "request": {
        "method": "GET",
        "urlPathPattern": "/perfil.*",
        "queryParameters": { "cliente": { "matches": ".*[0-9]$" } }
      },
      "response": { "status": 500, "fixedDelayMilliseconds": 800 }
    }
  ],
  "_nota": "Para un 15% exacto usar el random injector de WireMock o ajustar el matcher del cliente."
}
