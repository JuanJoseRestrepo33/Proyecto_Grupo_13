<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 y anteriores: misma política que data_extraction_rules.xml (sin copias de datos). -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
